{
  "name": "desk-habitat",
  "version": "0.1.0",
  "description": "A tiny animated animal habitat living on your desktop.",
  "main": "dist/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run build && concurrently --kill-others --success first \"npm:dev:renderer\" \"npm:dev:electron:watch\" \"npm:dev:electron\"",
    "dev:renderer": "vite build --watch --config vite.config.ts",
    "dev:electron:watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on dist/main/index.js dist/preload/index.js dist/renderer/index.html && nodemon --config nodemon.json",
    "start": "npm run build && electron .",
    "build": "npm run build:electron && npm run build:renderer",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-isolation=none \"tests/**/*.test.mts\"",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "setup:electron": "install-electron",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "pixi.js": "8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "concurrently": "10.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "10.8.0",
    "nodemon": "3.1.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "wait-on": "9.1.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
